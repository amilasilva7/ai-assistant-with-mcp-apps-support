# Copy this file to .env and fill in ANTHROPIC_API_KEY, then `npm run assistant`.
# Every other variable is optional; the defaults shown as comments match
# assistant/config.ts.

# Which LLM provider to use. "anthropic" (default), "gemini", "ollama", or
# "bedrock".
# ASSISTANT_LLM_PROVIDER=anthropic

# Anthropic API key (required when ASSISTANT_LLM_PROVIDER=anthropic).
# Get one at https://console.anthropic.com/
# ANTHROPIC_API_KEY=

# Gemini API key (required when ASSISTANT_LLM_PROVIDER=gemini).
# Get one at https://aistudio.google.com/apikey
# GEMINI_API_KEY=

# Ollama: no key needed (unauthenticated local server). Point this at a
# running Ollama instance if it's not on the default port — see
# scripts/start-with-ollama.sh, which stands one up in Docker for POC
# development when Anthropic/Gemini rate limits are in the way.
# OLLAMA_BASE_URL=http://localhost:11434

# AWS Bedrock: no key of its own — required when ASSISTANT_LLM_PROVIDER=bedrock
# is AWS_REGION (or AWS_DEFAULT_REGION), the standard AWS SDK region var.
# Credentials are resolved by the normal AWS chain (AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY, AWS_PROFILE, AWS_BEARER_TOKEN_BEDROCK, or the
# default provider chain — ~/.aws/credentials, SSO, an EC2/ECS/Lambda role) —
# whatever your `aws` CLI already uses will work here too. Requires Bedrock
# model access to be granted for the chosen model in that AWS account/region
# (AWS Console -> Bedrock -> Model access).
# AWS_REGION=us-east-1

# Model id. Verify against the provider's current model list before relying
# on these defaults.
# ASSISTANT_MODEL=claude-sonnet-4-5-20250929                    # anthropic default
# ASSISTANT_MODEL=gemini-3.6-flash                               # gemini default
# ASSISTANT_MODEL=llama3.1:8b                                    # ollama default
# ASSISTANT_MODEL=anthropic.claude-sonnet-4-5-20250929-v1:0      # bedrock default

# Port the assistant listens on (distinct from the MCP server's PORT=3001).
# ASSISTANT_PORT=3002

# Bind address. Anything other than 127.0.0.1/localhost requires
# ASSISTANT_ALLOW_REMOTE=1 (a startup warning names the risks: LLM credit
# spend, SSRF pivot).
# ASSISTANT_BIND=127.0.0.1
# ASSISTANT_ALLOW_REMOTE=1

# Optional read-only seed of user MCP servers to connect at startup, e.g.:
# ASSISTANT_SERVERS=[{"name":"local mcp","url":"http://localhost:3001/mcp"}]

# Fronting the assistant with a tunnel (e.g. `npx cloudflared tunnel --url
# http://localhost:3002`)? ASSISTANT_BIND stays 127.0.0.1 — the tunnel client
# runs locally and proxies back to loopback, no need to open the port. But
# set this to the tunnel's public URL (once cloudflared prints it) so the
# Origin/Host guard accepts it instead of 403'ing every request. This is an
# exact-origin allowlist, not authentication: anyone with the tunnel URL has
# full access (can spend your LLM API key, add MCP servers as an SSRF
# pivot) — only do this if you're okay with that for as long as it's up.
#ASSISTANT_PUBLIC_ORIGIN=https://thermal-developer-courts-hans.trycloudflare.com

# Bounded agentic loop (design D-6)
# ASSISTANT_MAX_TOOL_ITERATIONS=8
# ASSISTANT_MAX_TOOL_CALLS_PER_TURN=16
# ASSISTANT_TURN_TIMEOUT_MS=120000
# ASSISTANT_TOOL_TIMEOUT_MS=30000
# ASSISTANT_CONNECT_TIMEOUT_MS=10000

# Result truncation / history / output caps
# ASSISTANT_MAX_TOOL_RESULT_CHARS=24000
# ASSISTANT_MAX_MODEL_CONTEXT_CHARS=4000
# ASSISTANT_MAX_HISTORY_MESSAGES=40
# ASSISTANT_MAX_OUTPUT_TOKENS=4096

# Widget handshake timeout (ms); also sent to the browser via /api/config.
# ASSISTANT_WIDGET_INIT_TIMEOUT_MS=5000

# "debug" adds full JSON-RPC tracing.
# ASSISTANT_LOG_LEVEL=info
